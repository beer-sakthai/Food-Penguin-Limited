rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    // Core validation and access primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return request.auth.token.role == 'admin';
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Entity validation functions
    function isValidSalesOrder(data) {
      return data.keys().hasAll(['id', 'item', 'quantity', 'amount', 'branch'])
        && data.keys().size() <= 10
        && data.id is string && data.id.size() <= 64
        && data.item is string && data.item.size() <= 128
        && data.quantity is number && data.quantity >= 0
        && data.amount is number && data.amount >= 0
        && data.branch is string && data.branch.size() <= 128;
    }

    function isValidProductionTask(data) {
      return data.keys().hasAll(['id', 'itemName', 'status', 'quantity'])
        && data.keys().size() <= 10
        && data.id is string && data.id.size() <= 64
        && data.itemName is string && data.itemName.size() <= 128
        && data.status is string && data.status.size() <= 64
        && data.quantity is number && data.quantity >= 0;
    }

    function isValidWasteRecord(data) {
      return data.keys().hasAll(['id', 'item', 'weight', 'cost', 'reason'])
        && data.keys().size() <= 10
        && data.id is string && data.id.size() <= 64
        && data.item is string && data.item.size() <= 128
        && data.weight is number && data.weight >= 0
        && data.cost is number && data.cost >= 0
        && data.reason is string && data.reason.size() <= 256;
    }

    function isValidCompanyTarget(data) {
      return data.keys().hasAll(['id', 'name', 'targetValue', 'currentValue', 'category'])
        && data.keys().size() <= 10
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() <= 128
        && data.targetValue is number && data.targetValue >= 0
        && data.currentValue is number && data.currentValue >= 0
        && data.category is string && data.category.size() <= 64;
    }

    function isValidEmployeeHour(data) {
      return data.keys().hasAll(['id', 'name', 'role', 'scheduledHours'])
        && data.keys().size() <= 10
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() <= 128
        && data.role is string && data.role.size() <= 128
        && data.scheduledHours is number && data.scheduledHours >= 0;
    }

    function isValidInventoryItem(data) {
      return data.keys().hasAll(['id', 'name', 'currentQty', 'reorderLevel'])
        && data.keys().size() <= 10
        && data.id is string && data.id.size() <= 64
        && data.name is string && data.name.size() <= 128
        && data.currentQty is number && data.currentQty >= 0
        && data.reorderLevel is number && data.reorderLevel >= 0;
    }

    // Rules for individual collections
    match /orders/{orderId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(orderId) && isValidSalesOrder(incoming());
      allow update: if isVerified() && isValidId(orderId) && isValidSalesOrder(incoming());
      allow delete: if isVerified() && isValidId(orderId);
    }

    match /tasks/{taskId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(taskId) && isValidProductionTask(incoming());
      allow update: if isVerified() && isValidId(taskId) && isValidProductionTask(incoming());
      allow delete: if isVerified() && isValidId(taskId);
    }

    match /waste/{wasteId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(wasteId) && isValidWasteRecord(incoming());
      allow update: if isVerified() && isValidId(wasteId) && isValidWasteRecord(incoming());
      allow delete: if isVerified() && isValidId(wasteId);
    }

    match /targets/{targetId} {
      allow read: if isSignedIn();
      allow create: if isAdmin() && isValidId(targetId) && isValidCompanyTarget(incoming());
      allow update: if isAdmin() && isValidId(targetId) && isValidCompanyTarget(incoming());
      allow delete: if isAdmin() && isValidId(targetId);
    }

    match /hours/{hourId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(hourId) && isValidEmployeeHour(incoming());
      allow update: if isVerified() && isValidId(hourId) && isValidEmployeeHour(incoming());
      allow delete: if isVerified() && isValidId(hourId);
    }

    match /inventory/{itemId} {
      allow read: if isSignedIn();
      allow create: if isVerified() && isValidId(itemId) && isValidInventoryItem(incoming());
      allow update: if isVerified() && isValidId(itemId) && isValidInventoryItem(incoming());
      allow delete: if isVerified() && isValidId(itemId);
    }
  }
}
