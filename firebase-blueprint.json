{
  "entities": {
    "SalesOrder": {
      "title": "SalesOrder",
      "description": "Represents an individual sales transaction at a branch",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "date": { "type": "string" },
        "item": { "type": "string" },
        "category": { "type": "string" },
        "quantity": { "type": "number" },
        "amount": { "type": "number" },
        "barcode": { "type": "string" },
        "status": { "type": "string" },
        "branch": { "type": "string" }
      },
      "required": ["id", "item", "quantity", "amount", "branch"]
    },
    "ProductionTask": {
      "title": "ProductionTask",
      "description": "An active or completed kitchen prep/production task",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "itemName": { "type": "string" },
        "assignedTo": { "type": "string" },
        "status": { "type": "string" },
        "quantity": { "type": "number" },
        "priority": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "itemName", "status", "quantity"]
    },
    "WasteRecord": {
      "title": "WasteRecord",
      "description": "Log of raw or prepared food waste",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "item": { "type": "string" },
        "category": { "type": "string" },
        "weight": { "type": "number" },
        "cost": { "type": "number" },
        "reason": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "item", "weight", "cost", "reason"]
    },
    "CompanyTarget": {
      "title": "CompanyTarget",
      "description": "An operational or sales target set by the organization",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "metric": { "type": "string" },
        "targetValue": { "type": "number" },
        "currentValue": { "type": "number" },
        "unit": { "type": "string" },
        "category": { "type": "string" },
        "deadline": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "name", "targetValue", "currentValue", "category"]
    },
    "EmployeeHour": {
      "title": "EmployeeHour",
      "description": "Roster details and clocked hours of staff",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "scheduledHours": { "type": "number" },
        "actualHours": { "type": "number" },
        "shiftStart": { "type": "string" },
        "shiftEnd": { "type": "string" },
        "date": { "type": "string" }
      },
      "required": ["id", "name", "role", "scheduledHours"]
    },
    "InventoryItem": {
      "title": "InventoryItem",
      "description": "Raw ingredient or supply packaging inventory record",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "stockLevel": { "type": "number" },
        "currentQty": { "type": "number" },
        "unit": { "type": "string" },
        "reorderLevel": { "type": "number" },
        "status": { "type": "string" }
      },
      "required": ["id", "name", "currentQty", "reorderLevel"]
    }
  },
  "firestore": {
    "orders": {
      "schema": "SalesOrder",
      "description": "Collection of all sales order transactions"
    },
    "tasks": {
      "schema": "ProductionTask",
      "description": "Collection of active and completed production prep tasks"
    },
    "waste": {
      "schema": "WasteRecord",
      "description": "Collection of food waste logs"
    },
    "targets": {
      "schema": "CompanyTarget",
      "description": "Collection of operational company targets"
    },
    "hours": {
      "schema": "EmployeeHour",
      "description": "Collection of employee rostering and logged hours"
    },
    "inventory": {
      "schema": "InventoryItem",
      "description": "Collection of real-time inventory levels"
    }
  }
}
